# Omada — environment variable template
# Copy to .env and fill in real values for local development.
# Never commit .env with real secrets.

# --- Database ---
MONGODB_URI=mongodb://localhost:27017/omada
SPRING_DATA_MONGODB_URI=${MONGODB_URI}

# --- Redis ---
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- JWT (generate a strong secret, e.g. `openssl rand -base64 32`) ---
# Minimum 256 bits for HS256. Do not use the placeholder in production.
JWT_SECRET=change-me-to-a-strong-256-bit-secret-key
JWT_ACCESS_VALIDITY=900000
JWT_REFRESH_VALIDITY=604800000
